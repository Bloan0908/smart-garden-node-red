    {
        "id": "d25ae113544b1c6e",
        "type": "function",
        "z": "ee101a16bac96724",
        "name": "Tạp nội dung email test",
        "func": "// Lấy số lần tưới đã lưu\nlet count = flow.get(\"wateringCount\") || 0;\n\n// Lấy thời gian hiện tại\nlet now = new Date();\n\nlet timeText = now.toLocaleString(\"vi-VN\", {\n    timeZone: \"Asia/Ho_Chi_Minh\"\n});\n\n// Email người nhận.\n// Có thể đổi thành email của bạn.\nmsg.to = \"bthloan2006@gmail.com\";\n\n// Tiêu đề email\nmsg.topic = \"Báo cáo tưới nước hằng ngày - Vườn thông minh IoT\";\n\n// Nội dung email\nmsg.payload =\n    `BÁO CÁO HỆ THỐNG VƯỜN THÔNG MINH IOT\n\nThời gian gửi báo cáo: ${timeText}\n\nHôm nay hệ thống đã kích hoạt tưới nước: ${count} lần.\n\nGhi chú:\n- Đây là email báo cáo định kỳ hằng ngày.\n- Chức năng này dùng riêng cho yêu cầu Email.\n- Không dùng chung điều kiện với thông báo nhanh.\n\nTrân trọng,\nHệ thống Vườn Thông Minh IoT`;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 970,
        "y": 640,
        "wires": [
            [
                "8ca22e871b8c90bf"
            ]
        ]
    },
    {
        "id": "c66778300be0c369",
        "type": "function",
        "z": "ee101a16bac96724",
        "name": "Reset số lần tưới",
        "func": "// Sau khi gửi email báo cáo xong,\n// reset số lần tưới về 0 để bắt đầu chu kỳ mới.\nflow.set(\"wateringCount\", 0);\n\nmsg.payload = \"Đã gửi email và reset số lần tưới về 0.\";\n\nreturn msg;",
        "outputs": 1,
