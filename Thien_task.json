    {
        "id": "81dd5fa43716fbbd",
        "type": "ui-template",
        "z": "ee101a16bac96724",
        "group": "8cc669342acdbda5",
        "page": "",
        "ui": "",
        "name": "",
        "order": 1,
        "width": "6",
        "height": "4",
        "head": "",
        "format": "<template>\n    <div class=\"system-box\">\n        <div class=\"system-title\">\n            TRẠNG THÁI HỆ THỐNG\n        </div>\n\n        <div class=\"connection-status\">\n            <span\n                class=\"status-dot\"\n                :class=\"msg?.payload === 'ONLINE' ? 'dot-online' : 'dot-offline'\">\n            </span>\n\n            <span>\n                {{ msg?.payload === 'ONLINE'\n                    ? 'Đã kết nối WiFi'\n                    : 'Mất kết nối WiFi' }}\n            </span>\n        </div>\n    </div>\n</template>\n\n<style>\n.system-box {\n    width: 100%;\n    height: 100%;\n    min-height: 130px;\n    box-sizing: border-box;\n\n    background-color: #fffdf2;\n    border: 2px solid #333;\n    border-radius: 2px;\n\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n\n    padding: 14px;\n}\n\n.system-title {\n    color: #e86b64;\n    font-size: 14px;\n    font-weight: 700;\n    text-align: center;\n}\n\n.connection-status {\n    flex: 1;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 9px;\n\n    color: #444;\n    font-size: 16px;\n}\n\n.status-dot {\n    width: 12px;\n    height: 12px;\n    border-radius: 50%;\n}\n\n.dot-online {\n    background-color: #22c55e;\n    box-shadow: 0 0 6px #22c55e;\n}\n\n.dot-offline {\n    background-color: #ef4444;\n    box-shadow: 0 0 6px #ef4444;\n}\n</style>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 780,
        "y": 420,
        "wires": [
            []
        ]
    },
    {
        "id": "f2aa17ea72573c6f",
