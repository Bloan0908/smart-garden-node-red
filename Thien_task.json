    {
        "id": "73341536dca10ba2",
        "type": "function",
        "z": "ee101a16bac96724",
        "name": "Đếm số lần bấm tưới",
        "func": "// Lấy số lần tưới hiện tại.\n// Nếu chưa có thì mặc định là 0.\nlet count = flow.get(\"wateringCount\") || 0;\n\n// Mỗi lần bấm inject giả lập, tăng số lần tưới lên 1.\ncount = count + 1;\n\n// Lưu lại vào bộ nhớ flow của Node-RED.\nflow.set(\"wateringCount\", count);\n\n// In nội dung ra debug để kiểm tra.\nmsg.payload = \"Số lần tưới hôm nay: \" + count;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
